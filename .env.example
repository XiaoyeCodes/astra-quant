# ============================================================
# ASTRA 星枢 · 配置文件
# 首次运行 start.bat 会把本文件复制为 .env，之后只改 .env 即可。
# ============================================================

# ---- 桥接服务读取 Bitget 账户用的 API 密钥（可选）-------------
# 不填也能用：行情走 Bitget 公开接口，订单和成交从 OctoBot 读取。
# 如果要填，请在 Bitget 单独创建一个【只读】权限的密钥，不要复用 OctoBot 的交易密钥。
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ---- 网络代理（中国大陆网络通常需要）---------------------------
# 例：Clash 默认端口 7890 -> http://host.docker.internal:7890
BITGET_PROXY=
# 构建镜像时的 pip 源，国内可改为清华源
PIP_INDEX_URL=https://pypi.org/simple

# ---- 驾驶舱显示 ------------------------------------------------
# 始终监控的交易对（ccxt 写法，合约加 :USDT）
WATCH_SYMBOLS=BTC/USDT,ETH/USDT,BTC/USDT:USDT
# 打开页面时默认关注的交易对
FOCUS_SYMBOL=BTC/USDT
# 浏览器里打开 OctoBot 的地址
OCTOBOT_PUBLIC_URL=http://localhost:5001

# ---- AI（DeepSeek 等兼容 OpenAI 接口的大模型）------------------
# 同一个 Key 同时给 OctoBot（AI 信号 / AI 仓位策略）和驾驶舱（AI 行情判断）使用。
# 不填时：AI 策略无法下单，AI 行情判断不可用，指标行情判断照常工作。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# OctoBot 每天最多使用的 token 数（控制费用，留空不限制）
LLM_DAILY_TOKEN_LIMIT=300000
# AI 行情判断间隔（秒），每次约 2 千 token
AI_REGIME_PERIOD=1800
# 访问大模型用的代理（DeepSeek 国内可直连，留空即可）
LLM_PROXY=

# ---- 自动切换策略（只在模拟盘下工作）----------------------------
# 行情判断连续一致多少次才切换；策略至少运行多少小时才允许被自动换掉
AUTO_SWITCH_CONFIRM=3
AUTO_SWITCH_MIN_HOLD_HOURS=12

# ---- 紧急控制 ---------------------------------------------------
# true 时驾驶舱右上角出现“紧急停止”：撤销 OctoBot 全部挂单并停止 OctoBot
ENABLE_CONTROLS=true

# ---- 高级：轮询间隔（秒）---------------------------------------
TICKER_PERIOD=1.0
OCTOBOT_PERIOD=3.0
PRIVATE_PERIOD=8.0
